# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing
/coverage
/test-results
/playwright-report

# env — never commit real keys; .env.example is the only env file in git
.env*
!.env.example

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local agent settings (the vendored skills in .agents/ and the .claude/skills symlinks ARE committed)
.claude/settings.local.json
.impeccable/config.local.json

# misc
.DS_Store
*.pem
.idea
.vscode/*
!.vscode/extensions.json
.gitkeep
.impeccable/live/
