# Copy to .env.local — never commit .env.local.
#
# The app runs with NO keys at all: every AI surface falls back to a scripted
# stream built from the seeded data (see docs/ARCHITECTURE.md → "Two AI modes").
# Add a key to switch the same surfaces to the live model.

# --- AI (pick one) -----------------------------------------------------------

# Option A (recommended): Vercel AI Gateway static key.
# Create at https://vercel.com/dashboard → AI Gateway → API Keys.
# Plain "provider/model" strings in the AI SDK route through the gateway automatically.
AI_GATEWAY_API_KEY=

# Option B: Vercel OIDC instead of a static key (needs a linked Vercel project):
#   vercel link && vercel env pull .env.local
# This writes VERCEL_OIDC_TOKEN for you (expires ~24h locally; auto-refreshed on Vercel).

# --- Behaviour ---------------------------------------------------------------

# auto     = live when a key or OIDC token is present, scripted otherwise (default).
#            If the model fails before the first streamed byte, that request falls back to
#            the matching script and the UI label becomes "Demo answers".
# live     = always the model; errors show in the UI, no fallback. Without a key the UI
#            shows "No AI key is configured."
# scripted = never calls the model, even when a key exists. Use this on stage if the
#            venue wifi is bad.
MUNSHI_AI_MODE=auto

# Demo date for the seed (ISO date, e.g. 2026-10-08). Read ONLY by `pnpm seed`, which sets
# meta.day0 = this date minus 89 days; the running app never reads it. Empty = real today.
# To change the demo date: MUNSHI_DEMO_NOW=<date> pnpm seed, then commit world.json.
# Not an env var on Vercel.
MUNSHI_DEMO_NOW=
