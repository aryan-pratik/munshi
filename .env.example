# Copy to .env.local — never commit .env.local.
#
# The app runs with NO keys at all: every AI surface falls back to a scripted
# stream built from the seeded data (see docs/ARCHITECTURE.md → "Two AI modes").
# Add a key to switch the same surfaces to the live model.

# --- AI (pick one) -----------------------------------------------------------

# Option A (recommended): Vercel AI Gateway static key.
# Create at https://vercel.com/dashboard → AI Gateway → API Keys.
# Plain "provider/model" strings in the AI SDK route through the gateway automatically.
AI_GATEWAY_API_KEY=

# Option B: Vercel OIDC instead of a static key (needs a linked Vercel project):
#   vercel link && vercel env pull .env.local
# This writes VERCEL_OIDC_TOKEN for you (expires ~24h locally; auto-refreshed on Vercel).

# --- Behaviour ---------------------------------------------------------------

# auto     = live when a key/token is present, scripted otherwise (default)
# live     = always call the model (errors surface in the UI)
# scripted = never call the model — use this on stage if the venue wifi is bad
MUNSHI_AI_MODE=auto

# Pin "today" for a repeatable demo (ISO date). Empty = real today.
# All seed data is stored as day offsets from this date, so the demo never goes stale.
MUNSHI_DEMO_NOW=
